# Build-time overrides for the example app. Copy to `.env` and fill in your
# values, then run/build with:
#   flutter run --dart-define-from-file=example/.env
#   flutter build apk --dart-define-from-file=example/.env
#
# Environment wins over the `.flutter_ota_kit/` project config and over the
# defaults in lib/flutter_ota_kit_setup.dart. Keep this file out of git
# (only .env.example is committed).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_BUCKET=bundles
CHANNEL=production
APP_VERSION=1.0.0
SDK_VERSION=1.0.0
