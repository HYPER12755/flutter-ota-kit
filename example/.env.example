# Example app secrets. Copy to `.env` and fill in real values.
# `.env` is git-ignored; this placeholder template is committed.
#
# Read at build time via:
#   flutter build apk --release --dart-define-from-file=.env
# or for dev:
#   flutter run --dart-define-from-file=.env

SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_BUCKET=bundles
CHANNEL=production
APP_VERSION=1.0.0
SDK_VERSION=1.0.0
