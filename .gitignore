# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Claude Code workspace metadata
.claude/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
/coverage/
/dist/

# Workspace scratch space (repro projects, e2e harness output, build artifacts).
# Already excluded from the published tarball via .pubignore.
/temp/
/plan/

# local OTA test artifacts
.ota/

# CLI / SDK project config written by `flutter-ota init` (may contain secrets).
.flutter_ota_kit/

# Example app local secrets (real Supabase creds). Keep out of git;
# example/.env.example (placeholders) is committed instead.
example/.env

# Monorepo package build dirs
**/build/
