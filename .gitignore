# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Claude Code workspace metadata
.claude/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
/coverage/
/dist/

# Workspace scratch space (repro projects, e2e harness output, build artifacts).
# Already excluded from the published tarball via .pubignore.
/temp/
/plan/

# local OTA test artifacts
.ota/

# CLI / SDK project config written by `flutter-ota init` (may contain secrets).
.flutter_ota_kit/

# Example app local secrets (real Supabase creds). Keep out of git;
# example/.env.example (placeholders) is committed instead.
example/.env

# Monorepo package build dirs
**/build/

# CLI build artifact (OTA patch output)
packages/cli-tools/dist/

# Pre-built CLI binaries (downloaded by users via the npm install script
# in npm/flutter-ota/scripts/postinstall.js). Re-checked-in to the
# repo would bloat history and break on architectures we don't ship for.
npm/flutter-ota/bin/

# Vendored Dart source for the npm package. Generated by
# `npm/flutter-ota/scripts/vendor.sh` from the monorepo; not source.
# Tracked in git only by mistake. Removing fixes pana's "multiple
# matching pubspecs" convention-check failure on every package.
npm/flutter-ota/dart-src/

# Binary/large asset artifacts that don't belong in a git repo
*.zip
*.gz
*.tar
*.tar.xz
*.gif
*.wasm
*.symbols
*.snap
.pubignore.bak
